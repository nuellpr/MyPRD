# ===== Wajib =====
# Kunci rahasia aplikasi (min 16 karakter). Dipakai untuk tanda tangan cookie sesi
# dan enkripsi data PRD/chat (AES-256-GCM). Generate: openssl rand -hex 32
APP_SECRET=ganti-dengan-random-string-panjang-minimal-32-karakter

# ===== Opsional: database & kuota =====
# Path file SQLite (relatif terhadap root project).
DATABASE_PATH=data/myprd.db
# Kuota generate PRD/bulan untuk tier free.
FREE_MONTHLY_QUOTA=5

# Batas diam provider AI (milidetik). Kalau provider tidak mengirim data selama
# ini, stream dianggap macet: teks yang sudah diterima tetap disimpan sebagai
# draf parsial, dan user diminta menekan Generate PRD lagi. Default 120000.
# AI_IDLE_TIMEOUT_MS=120000

# ===== Opsional: pilihan model =====
# Format: provider/model. Kalau kosong, otomatis pakai provider pertama yang
# punya API key, atau provider "mock" (demo tanpa API key) bila tidak ada.
AI_DEFAULT_MODEL=gemini/gemini-3.8-flash

# ===== Opsional: API key provider AI =====
# Provider tanpa API key tidak akan muncul di pilihan model. Semua provider
# memakai protokol OpenAI-compatible.
#
# BangunWeb AI Router (https://router.bangunweb.com/v1)
# BANGUNWEB_API_KEY=
# BANGUNWEB_BASE_URL=https://router.bangunweb.com/v1
# BANGUNWEB_MODELS=bw-swift,deepseek-v4.1-flash,gpt-5.4-mini,gpt-6.2-astra,gpt-6.2-sol
#
# Google Gemini (endpoint OpenAI-compatible resmi Google AI Studio).
# Ambil key di https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODELS=gpt-4o-mini,gpt-4o
# OPENROUTER_API_KEY=
# OPENROUTER_MODELS=deepseek/deepseek-chat-v3.1,anthropic/claude-sonnet-4.5
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODELS=kimi-k2-0905-preview,moonshot-v1-32k
# QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODELS=qwen3-coder-plus,qwen-plus
# GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile

# ===== Opsional: provider custom (OpenAI-compatible apa pun) =====
# CUSTOM_BASE_URL=https://api.contoh.com/v1
# CUSTOM_LABEL=Provider Saya
# CUSTOM_API_KEY=
# CUSTOM_MODELS=model-a,model-b
# CUSTOM_COST_IN=0
# CUSTOM_COST_OUT=0

# ===== Opsional: billing langganan (QRIS Dinamis / Midtrans Snap / Mayar / mock) =====
# Tanpa merchant key, aplikasi memakai provider "mock": alur checkout →
# upgrade paket bisa dicoba lewat tombol simulasi di halaman /billing.
# PILIHAN BILLING_PROVIDER: mock | qris | midtrans | mayar
# - qris memakai string QRIS statis (contoh GoPay Merchant) lalu menyisipkan nominal
#   unik + CRC16 dinamis secara lokal tanpa fee gateway eksternal.
# - midtrans aktif otomatis begitu MIDTRANS_SERVER_KEY terisi.
# - mayar HARUS ditulis eksplisit (BILLING_PROVIDER=mayar) walau MAYAR_API_KEY
#   sudah ada, supaya user tidak terlanjur dikirim ke halaman bayar produksi.
# - mock dipakai saat developer ingin mengunci mode simulasi.
# BILLING_PROVIDER=mock
# QRIS_STATIC_PAYLOAD=000201010211...
#
# --- Midtrans Snap ---
# Isi key di bawah untuk pembayaran asli (sandbox dulu):
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_IS_PRODUCTION=false
# Daftarkan Payment Notification URL (mis. https://domainmu/api/billing/webhook)
# di dashboard Midtrans agar order otomatis lunas setelah user membayar.
#
# --- Mayar (Single Payment Request, API V2) ---
# API key dari https://web.mayar.id/api-keys → pilih "Read & Write".
# Host .io = sandbox, host .id = produksi. API V1 dimatikan 1 Oktober 2026.
# MAYAR_API_KEY=
# MAYAR_IS_PRODUCTION=false
# Daftarkan webhook URL (https://domainmu/api/billing/webhook) di
# https://web.mayar.id/development/webhooks lalu aktifkan event payment.received.
# Webhook Mayar tidak ditandatangani, jadi server memverifikasi ulang status ke
# API Mayar sebelum paket di-upgrade.

# ===== Opsional: login via Google OAuth =====
# Tanpa kredensial ini, tombol "Lanjutkan dengan Google" disembunyikan dan
# login hanya via email + password. Cara mendapatkan:
# 1. Buka https://console.cloud.google.com/apis/credentials → Create Credentials
#    → OAuth client ID → tipe "Web application".
# 2. Tambahkan Authorized redirect URI persis seperti di bawah (sesuaikan domain).
# 3. Salin Client ID & Client Secret ke sini.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Untuk produksi di balik reverse proxy / domain sendiri (opsional):
# GOOGLE_REDIRECT_URI=https://domainmu/api/auth/google/callback
# Lokal: http://localhost:3000/api/auth/google/callback

# ===== Opsional: admin =====
# Email admin (dipisah koma). Admin mendapat badge di halaman pengaturan.
# Contoh: ADMIN_EMAILS=kamu@gmail.com

# ===== Opsional: reset password lewat email =====
# Tanpa ini, link reset muncul di log server saat NODE_ENV≠production (mode dev).
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=MyPRD <no-reply@domainmu.web.id>
# Catatan: verifikasi domain di dashboard Resend dulu, baru pakai domain sendiri di EMAIL_FROM.
# onboarding@resend.dev hanya bisa kirim ke email akun Resend sendiri.
# Tanpa domain terverifikasi, onboarding@resend.dev hanya bisa ke email akun Resend sendiri.
